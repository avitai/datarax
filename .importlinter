[importlinter]
root_package = datarax

[importlinter:contract:layers]
name = Datarax layered architecture
type = layers
layers =
    datarax.cli
    datarax.monitoring
    datarax.pipeline
    datarax.operators
    datarax.sources
    datarax.sharding
    datarax.control
    datarax.memory
    datarax.performance
    datarax.samplers
    datarax.batching
    datarax.utils
    datarax.core

[importlinter:contract:pipeline-internal]
name = Pipeline drives its iteration machinery, which knows nothing of Pipeline
type = layers
layers =
    datarax.pipeline.pipeline
    datarax.pipeline.iteration
    datarax.pipeline.epochs
