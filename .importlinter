[importlinter]
root_package = datarax

[importlinter:contract:layers]
name = Datarax layered architecture
type = layers
layers =
    datarax.cli
    datarax.monitoring
    datarax.pipeline
    datarax.operators
    datarax.sources
    datarax.sharding
    datarax.control
    datarax.performance
    datarax.samplers
    datarax.batching
    datarax.utils
    datarax.core

[importlinter:contract:pipeline-internal]
name = Pipeline drives its iteration machinery, which knows nothing of Pipeline
type = layers
layers =
    datarax.pipeline.pipeline
    datarax.pipeline.host_stage | datarax.pipeline.iteration
    datarax.pipeline.run_configuration | datarax.pipeline.run_units
    datarax.pipeline.epochs | datarax.pipeline.dag_call | datarax.pipeline.read_plan
    datarax.pipeline.host_workers
