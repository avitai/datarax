[importlinter]
root_package = datarax

[importlinter:contract:layers]
name = Datarax layered architecture
type = layers
layers =
    datarax.cli
    datarax.checkpoint
    datarax.monitoring
    datarax.pipeline
    datarax.operators
    datarax.sources
    datarax.sharding
    datarax.control
    datarax.performance
    datarax.samplers
    datarax.batching
    datarax.utils
    datarax.config
    datarax.core
    datarax.typing

[importlinter:contract:pipeline-internal]
name = Pipeline drives its iteration machinery, which knows nothing of Pipeline
type = layers
layers =
    datarax.pipeline.pipeline
    datarax.pipeline.host_stage | datarax.pipeline.iteration | datarax.pipeline.materialization
    datarax.pipeline.run_configuration | datarax.pipeline.run_units
    datarax.pipeline.epochs | datarax.pipeline.dag_call | datarax.pipeline.read_plan | datarax.pipeline.placement
    datarax.pipeline.host_workers

[importlinter:contract:tfds-sources]
name = TFDS sources build on the stream order and the TFRecord reader, which know nothing of them
type = layers
layers =
    datarax.sources.tfds_source
    datarax.sources.tfds_streaming_source
    datarax.sources._stream_order | datarax.sources._tfds_identity | datarax.sources._tfds_prepared
    datarax.sources._tfrecord

[importlinter:contract:decoded-copy]
name = The decoded copy's manifest over its files over its units over its layout
type = layers
containers =
    datarax.sources.decoded_copy
layers =
    _manifest
    _files
    _units
    _layout

[importlinter:contract:disk-sources]
name = The decoded copy reads back as a disk source; both share the provenance codec below them
type = layers
layers =
    datarax.sources.decoded_copy
    datarax.sources.streaming_disk_source
    datarax.sources._disk_provenance
